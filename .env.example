# Copy to .env and fill in real values. .env is gitignored -- never commit it.

# --- Django core ---
# Generate: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Sign-in restriction ---
# Only Google accounts on this email domain may sign in. Required: if this is
# empty, every sign-in is refused.
ALLOWED_EMAIL_DOMAIN=

# --- PostgreSQL ---
POSTGRES_DB=pgdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (channels layer for websockets) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Production only (ignored while DJANGO_DEBUG=True) ---
# CORS_ALLOWED_ORIGINS=https://example.com
# CSRF_TRUSTED_ORIGINS=https://example.com
# SECURE_SSL_REDIRECT=True
